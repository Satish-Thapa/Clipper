DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-v4-pro
# ffmpeg must have libass (subtitles filter); ffprobe must be next to it.
# Windows: a full build unzipped to C:fmpeg. macOS: brew install ffmpeg-full -> /opt/homebrew/opt/ffmpeg-full/bin/ffmpeg
FFMPEG=C:/ffmpeg/bin/ffmpeg.exe
# tiny | base | small | medium | large-v3
WHISPER_MODEL=small
LIVE_CHUNK_SECONDS=600
# Source videos are deleted once clipped (clips stay). 1 = keep them, to cut more clips from them later by hand.
KEEP_SOURCES=0

# Clip lengths in seconds. Every kind is vertical 9:16 and capped at 180s (YouTube Shorts limit), whatever is set here.
SHORT_MIN=15
SHORT_MAX=60
LONG_MIN=60
LONG_MAX=180
# How far over the max the AI may go when a moment needs a bit more context
STRETCH_SHORT=10
STRETCH_LONG=10
# Shorts layout: how much of the original frame to keep, as width/height. 1 = square (gameplay centred,
# headline in the black bar above, captions in the black bar below). 0.5625 = old full-height crop (no bars).
# 1.78 = whole 16:9 frame (smallest picture, biggest bars).
CROP_ASPECT=1
# Logo watermark on every clip (top-right). Point to your own PNG, or leave empty (LOGO=) for none.
# LOGO=/path/to/logo.png
# AI voice-over voice. Windows: a SAPI voice name (Settings > Time & language > Speech), e.g. Microsoft Zira Desktop.
# macOS: a 'say' voice (list: say -v '?'). Empty = system default.
VOICE=

# Facebook Page + Instagram (README: Connecting your socials). Leave empty to skip a platform.
FB_PAGE_ID=
FB_PAGE_TOKEN=
IG_USER_ID=
# IG_TOKEN=          # only if Instagram needs a different token than FB_PAGE_TOKEN
# GRAPH_VERSION=v23.0
# TikTok Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=
TIKTOK_PRIVACY=SELF_ONLY
# Topic search: only clip videos between these lengths (minutes)
TOPIC_MIN_MINUTES=3
TOPIC_MAX_MINUTES=90
# Country whose YouTube search results topics use (what is trending there)
SEARCH_REGION=US
# Hourly WhatsApp report via Meta's WhatsApp Cloud API (README: WhatsApp report)
WA_PHONE_NUMBER_ID=
WA_TOKEN=
# your own WhatsApp number, country code first, e.g. 9779800000000
WA_TO=
# approved template with one {{1}} variable, used when you haven't messaged the number in 24h
WA_TEMPLATE=clipper_report
WA_TEMPLATE_LANG=en_US
REPORT_MINUTES=60
# End-of-clip call to action (animated). Empty = off
END_CARD=FOLLOW
# Line above the headline pushing viewers to follow. Empty = one of 6 built-in lines, picked at random.
FOLLOW_LINE=
# Instagram's API often rejects Reels over ~30s: longer clips get a red "may fail" Instagram button. 0 = off.
IG_MAX_SECONDS=30
# Fact posts from Wikipedia need a contact in the User-Agent (its robot policy): your email or site.
# Empty = facts come from news articles instead.
WIKI_CONTACT=
# YouTube "Sign in to confirm you're not a bot": add cookies on the Socials page (saved as cookies.txt), or read them
# from a browser yt-dlp can open (firefox; Chrome/Edge on Windows lock theirs).
# YT_COOKIES=cookies.txt
# YT_COOKIES_FROM_BROWSER=firefox
