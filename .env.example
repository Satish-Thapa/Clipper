# Only keys, logins and paths live here. Everything you tune (slots, clip lengths, research...) is on the
# Settings page of the app. Change this file -> restart the server.

# ---- AI: every call tries them in the order set in Settings -> AI models ----
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-v4-pro
# Any OpenAI-compatible AI (Ollama / LM Studio on another machine, OpenAI, OpenRouter, Groq, Gemini...)
#   Ollama on another machine  LLM_BASE_URL=http://<that machine's address>:11434/v1   (no key)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-oss:20b
# A small model on THIS computer (Ollama installed here), the last fallback
PC_LLM_BASE_URL=http://localhost:11434/v1
PC_LLM_MODEL=qwen3.5:2b

# ---- tools ----
# ffmpeg must have libass (subtitles filter); ffprobe must be next to it.
# Windows: a full build unzipped to C:\ffmpeg. macOS: brew install ffmpeg-full -> /opt/homebrew/opt/ffmpeg-full/bin/ffmpeg
FFMPEG=C:/ffmpeg/bin/ffmpeg.exe
# tiny | base | small | medium | large-v3
WHISPER_MODEL=small

# ---- YouTube downloads: "Sign in to confirm you're not a bot" -> add cookies on the Socials page, or read them from
# a browser yt-dlp can open (firefox; Chrome/Edge on Windows lock theirs) ----
# YT_COOKIES=cookies.txt
# YT_COOKIES_FROM_BROWSER=firefox

# ---- Facebook Page + Instagram (README: Connecting your socials). Empty = skip that platform ----
FB_PAGE_ID=
FB_PAGE_TOKEN=
IG_USER_ID=
# IG_TOKEN=          # only if Instagram needs a different token than FB_PAGE_TOKEN
# GRAPH_VERSION=v23.0

# ---- TikTok Content Posting API ----
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=
TIKTOK_PRIVACY=SELF_ONLY

# ---- News & facts posts (switched off for now) ----
# LOGO=/path/to/logo.png
# FOLLOW_LINE=
# VOICE=
# WIKI_CONTACT=
