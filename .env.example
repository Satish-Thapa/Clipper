DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-v4-pro
# ffmpeg must have libass (subtitles filter). macOS: brew install ffmpeg-full
FFMPEG=/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg
# tiny | base | small | medium | large-v3
WHISPER_MODEL=small
LIVE_CHUNK_SECONDS=600

# Clip lengths in seconds. Every kind is vertical 9:16 and capped at 180s (YouTube Shorts limit), whatever is set here.
SHORT_MIN=15
SHORT_MAX=60
LONG_MIN=60
LONG_MAX=180
# How far over the max the AI may go when a moment needs a bit more context
STRETCH_SHORT=10
STRETCH_LONG=10
# Shorts layout: how much of the original frame to keep, as width/height. 1 = square (gameplay centred,
# headline in the black bar above, captions in the black bar below). 0.5625 = old full-height crop (no bars).
# 1.78 = whole 16:9 frame (smallest picture, biggest bars).
CROP_ASPECT=1
# Logo watermark on every clip (top-right). Point to your own PNG, or leave empty (LOGO=) for none.
# LOGO=/path/to/logo.png
# AI voice-over voice (macOS 'say'). List: say -v '?'   Better free voices: System Settings > Accessibility >
# Spoken Content > System Voice > Manage Voices (download an Enhanced/Premium one, then put its name here).
VOICE=

# Facebook Page + Instagram (see README "Facebook / Instagram / TikTok setup"). Leave empty to skip a platform.
FB_PAGE_ID=
FB_PAGE_TOKEN=
IG_USER_ID=
# IG_TOKEN=          # only if Instagram needs a different token than FB_PAGE_TOKEN
# GRAPH_VERSION=v23.0
# TikTok Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=
TIKTOK_PRIVACY=SELF_ONLY
# Topic search: only clip videos between these lengths (minutes)
TOPIC_MIN_MINUTES=3
TOPIC_MAX_MINUTES=90
# Country whose YouTube search results topics use (what is trending there)
SEARCH_REGION=US
# Hourly WhatsApp report via CallMeBot (free, see README). Phone with country code, e.g. +15551234567
WHATSAPP_PHONE=
WHATSAPP_APIKEY=
REPORT_MINUTES=60
# End-of-clip call to action (animated). Empty = off
END_CARD=FOLLOW FOR MORE
# Uploads allowed per 24h per platform (0 = no limit)
UPLOAD_LIMIT_YOUTUBE=10
